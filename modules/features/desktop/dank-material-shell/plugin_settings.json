{
  "batteryPlus": {
    "enabled": true
  },
  "dockerManager": {
    "enabled": true,
    "dockerBinary": "podman",
    "terminalApp": "kitty",
    "shellPath": "/home/@USERNAME@/.nix-profile/bin/fish"
  },
  "dankKDEConnect": {
    "enabled": true,
    "selectedDeviceId": "e100d420_afce_4f41_bb37_58887ccfc478"
  },
  "dankNotepadModule": {
    "enabled": true,
    "style": "github-dark"
  },
  "calculator": {
    "enabled": true,
    "trigger": "=",
    "noTrigger": false,
    "calcEngine": "qalc"
  },
  "commandRunner": {
    "enabled": true,
    "terminal": "kitty",
    "history": [
      "labwc --startup eden",
      "labwc --startup reaper",
      "labwc --startup ryujinx",
      "scrcpy --new-display=1920x1080/240 --window-x 0 --window-y 0"
    ],
    "trigger": "$",
    "noTrigger": false
  },
  "emojiLauncher": {
    "enabled": true,
    "noTrigger": false,
    "trigger": ":"
  },
  "niriWindows": {
    "enabled": true,
    "noTrigger": false,
    "trigger": "!"
  },
  "webSearch": {
    "enabled": true,
    "searchEngines": [],
    "defaultEngine": "duckduckgo",
    "noTrigger": false,
    "trigger": ">",
    "disabledEngines": [
      "brave",
      "bing",
      "kagi",
      "ebay",
      "linkedin",
      "imdb"
    ]
  },
  "dankHooks": {
    "enabled": true
  },
  "dankPinentry": {
    "enabled": true
  }
}
